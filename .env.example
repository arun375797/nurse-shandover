# Copy to .env for local development.
# Frontend (Vercel) and backend (Render/Railway/etc.) use different env sets — see README.

# --- Backend (server) ---
MONGODB_URI=mongodb://127.0.0.1:27017/bedsiderelay
SESSION_SECRET=dev-only-session-secret-change-in-production-32c
CLIENT_ORIGIN=http://localhost:5173
PORT=4000
NODE_ENV=development
APP_TIMEZONE=Asia/Kolkata
COOKIE_NAME=br.sid
# Use "none" when UI and API are on different domains (production split hosting). Local Vite proxy: keep "lax".
COOKIE_SAMESITE=lax
SESSION_MAX_AGE_MS=28800000
INACTIVITY_TIMEOUT_MS=1800000
SEED_NURSE_PASSWORD=NurseDev!234
SEED_ADMIN_PASSWORD=AdminDev!234

# --- Frontend (Vite / Vercel) ---
# Leave empty for local `npm run dev` (Vite proxies /api → localhost:4000).
# On Vercel set to your API origin, e.g. https://bedsiderelay-api.onrender.com
# VITE_API_URL=
